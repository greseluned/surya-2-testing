    <TextRegion id="r3" type="paragraph" custom="readingOrder {index:3;} structure {type:Text;}">
      <Coords points="466,1631 2177,1631 2177,1979 466,1979" />
      <TextEquiv conf="0.9981">
        <Unicode>Trajes, Faldas, Kimonas, Blusas, Batas, Abanicos,
Sombrillas, Sombreros elegantísimos, Velos
para la cara, Guantes, Cintas, Encajes, Bordados,
Adornos de todas clases, Camisas de hilo
españolas, Corsets, Pañuelos,</Unicode>
      </TextEquiv>
    </TextRegion>
