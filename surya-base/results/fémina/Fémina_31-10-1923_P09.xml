    <TextRegion id="r3" type="heading" custom="readingOrder {index:3;} structure {type:SectionHeader;}">
      <Coords points="1197,779 1676,779 1676,863 1197,863" />
      <TextEquiv conf="0.9267">
        <Unicode>BREVE Y FRAGIL.</Unicode>
      </TextEquiv>
    </TextRegion>
    <TextRegion id="r4" type="paragraph" custom="readingOrder {index:4;} structure {type:Text;}">
      <Coords points="979,912 1728,912 1728,1842 979,1842" />
      <TextEquiv conf="0.9931">
        <Unicode>¡Oh! grácil
rosa
frágil,
Primavera •
fundió para tu ser, todo su aroma
y su belleza
toda;
porque en los delicados
milagros
de su espléndida floresta
faltaba
un hada
azul que presidiera
aquella
pomipa agreste.</Unicode>
      </TextEquiv>
    </TextRegion>
    <TextRegion id="r5" type="paragraph" custom="readingOrder {index:5;} structure {type:Text;}">
      <Coords points="977,1880 1854,1880 1854,2192 977,2192" />
      <TextEquiv conf="0.9949">
        <Unicode>Y dicen que su antojo fue su muerte, porque se halló más grácil tu belleza que su belleza misma, y se murió de irresistible envidia la maga Primavera.....</Unicode>
      </TextEquiv>
    </TextRegion>
