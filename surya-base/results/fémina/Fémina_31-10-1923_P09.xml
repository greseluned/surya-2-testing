    <TextRegion id="r9" type="paragraph" custom="readingOrder {index:9;} structure {type:Text;}">
      <Coords points="226,2526 1230,2526 1230,2792 226,2792" />
      <TextEquiv conf="0.9994">
        <Unicode>Abril que en aquellos días había leído la obra de Lamartine titulada... donde figura una joven con el nombre de Flor Daliza, lo recogió y se lo puso a los artículos de la Srta. Josefina Moll.</Unicode>
      </TextEquiv>
    </TextRegion>
